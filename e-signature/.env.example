# Base URL of the backend implementing docs/API.md (no trailing slash).
# With the built-in mock: http://localhost:3000/api/mock
SIGNATURE_API_URL=http://localhost:3000/api/mock
# Sent as "Authorization: Bearer <key>" to the backend (server-side only).
SIGNATURE_API_KEY=

# Shared with the backend: AES-256-GCM key that encrypts signing links (32 bytes, base64).
# Generate: openssl rand -base64 32   — this dev value must NOT be reused in production.
ESIGN_LINK_KEY=RfLb5QP1Xv9vNoSupoVeLSOPDbcZ+I0U7RjJ0jORhpo=
# Origins the portal may download documents from (comma-separated), e.g. your S3 bucket.
DOCUMENT_ALLOWED_ORIGINS=http://localhost:3000

# Built-in mock backend + /dev console. Never enable in production.
MOCK_API=true
# Optional: the mock POSTs its webhooks here, signed with MOCK_WEBHOOK_SECRET (HMAC-SHA256).
MOCK_WEBHOOK_URL=
MOCK_WEBHOOK_SECRET=dev-secret
